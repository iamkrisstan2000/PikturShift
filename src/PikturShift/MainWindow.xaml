<Window x:Class="PikturShift.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PikturShift"
        Icon="Assets/app.ico"
        Width="1120" Height="760" MinWidth="920" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFont}"
        FontSize="12.5"
        SnapsToDevicePixels="True"
        AllowDrop="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseFilesCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ConvertCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding SetPageCommand}" CommandParameter="settings" />
        <KeyBinding Key="F1" Command="{Binding SetPageCommand}" CommandParameter="settings" />
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ================================================= caption bar -->
            <Grid Grid.Row="0" Background="{DynamicResource CaptionBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" x:Name="TitleIcon" Source="Assets/app-32.png"
                       Width="17" Height="17" Margin="13,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Grid.Column="1" Text="PikturShift" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.86" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" Click="OnMinimizeClick" ToolTip="Minimize" />
                    <Button x:Name="MaxRestoreButton" Style="{StaticResource CaptionButtonStyle}" Content="&#xE922;" Click="OnMaximizeClick" ToolTip="Maximize" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="&#xE8BB;" Click="OnCloseClick" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ======================================================== body
                 The body itself stays unpainted so both translucent surfaces reach the
                 backdrop. The small corner patch and 1 px seam below use the exact same
                 translucent rail brush as the navigation pane, so the rounded notch never
                 becomes a darker opaque square and still reveals the Mica backdrop. -->
            <Grid Grid.Row="1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- =============================================== navigation
                     One pane that widens in place (WinUI NavigationView behaviour):
                     collapsed 48 px shows centred icons, expanded 196 px adds labels.
                     Nothing is duplicated when the pane opens. -->
                <Border x:Name="NavPane" Background="{DynamicResource RailBgBrush}"
                        SizeChanged="OnNavPaneSizeChanged">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="48" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.NavExpanded, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="196"
                                                                 Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="48"
                                                                 Duration="0:0:0.15">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- collapse / expand -->
                        <Button Grid.Row="0" x:Name="NavToggleButton"
                                FontSize="14"
                                Command="{Binding ToggleNavCommand}"
                                ToolTip="Collapse or expand the menu">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,8,0,6" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Content" Value="&#xE700;" />
                                    <Setter Property="ToolTip" Value="Expand the menu" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NavExpanded}" Value="True">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="9,8,0,6" />
                                            <Setter Property="ToolTip" Value="Collapse the menu" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,2,0,0">
                            <RadioButton GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                         Tag="&#xE91B;" Content="Converter" ToolTip="Converter"
                                         IsChecked="{Binding IsConverterPage, Mode=OneWay}"
                                         Command="{Binding SetPageCommand}" CommandParameter="converter" />
                        </StackPanel>

                        <!-- settings lives once, pinned at the bottom like WinUI -->
                        <Border Grid.Row="3" Height="1" Margin="10,6,10,6"
                                Background="{DynamicResource DividerBrush}" />
                        <RadioButton Grid.Row="4" GroupName="Nav" Style="{StaticResource NavItemStyle}"
                                     Tag="&#xE713;" Content="Settings" ToolTip="Settings"
                                     Margin="3,0,3,8"
                                     IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                                     Command="{Binding SetPageCommand}" CommandParameter="settings" />
                    </Grid>
                </Border>

                <!-- Extend the translucent rail surface beneath the content's rounded notch
                     and along the seam; it must stay the same alpha as the rail itself. -->
                <Rectangle Grid.Column="1" Width="10" Height="10"
                           HorizontalAlignment="Left" VerticalAlignment="Top"
                           Fill="{DynamicResource RailBgBrush}" />
                <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left"
                           Fill="{DynamicResource RailBgBrush}" />

                <!-- ============================================ content area -->
                <Border Grid.Column="1" Background="{DynamicResource ContentBgBrush}"
                        CornerRadius="10,0,0,0">
                    <Grid>

                    <!-- ======================================== converter page -->
                    <Grid Visibility="{Binding IsConverterPage, Converter={StaticResource BoolToVis}}"
                          Margin="22,8,20,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Converter" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="Convert JPG, PNG, WebP, BMP, GIF and TIFF &#x2014; a single file or hundreds at once." />
                        </StackPanel>

                        <!-- drop zone -->
                        <Grid Grid.Row="1" Margin="0,10,0,0" Height="102">
                            <Rectangle RadiusX="8" RadiusY="8"
                                       Stroke="{DynamicResource SurfaceBorderBrush}" StrokeThickness="1"
                                       StrokeDashArray="4 3" Fill="{DynamicResource SurfaceBrush}" />
                            <Rectangle x:Name="DropDashHover" RadiusX="8" RadiusY="8"
                                       Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                       StrokeDashArray="4 3" Fill="{DynamicResource DropHoverBrush}"
                                       Opacity="0" IsHitTestVisible="False" />
                            <Border x:Name="DropHitArea" Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="OnDropZoneClick">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,7" />
                                    <TextBlock Text="Drag &amp; drop images here" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5"
                                               Text="or click to browse &#x00B7; JPG &#x00B7; PNG &#x00B7; WebP &#x00B7; BMP &#x00B7; TIFF &#x00B7; GIF" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- files + options -->
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="304" />
                            </Grid.ColumnDefinitions>

                            <!-- file queue card -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="16,0,10,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Files" Style="{StaticResource CardTitleStyle}" />
                                            <Border Background="{DynamicResource ControlBgBrush}" CornerRadius="8"
                                                    Padding="7,1" Margin="9,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Jobs.Count}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE710;" FontSize="15"
                                                    Command="{Binding BrowseFilesCommand}" ToolTip="Add images (Ctrl+O)" />
                                            <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74D;" FontSize="13"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding ClearCommand}" ToolTip="Clear the queue" />
                                        </StackPanel>
                                    </Grid>

                                    <ListBox Grid.Row="1" Style="{StaticResource QueueListStyle}"
                                             ItemsSource="{Binding Jobs}"
                                             SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                                             Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}"
                                             MouseDoubleClick="OnJobDoubleClick">
                                        <!-- Delete only applies while the list itself has focus, so typing
                                             in a text box never removes a queued file. -->
                                        <ListBox.InputBindings>
                                            <KeyBinding Key="Delete" Command="{Binding RemoveSelectedCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="46">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" Width="40" Height="40">
                                                        <Border CornerRadius="5" Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                BorderThickness="1">
                                                            <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="15" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisInverted}}" />
                                                        </Border>
                                                        <Border CornerRadius="5" BorderThickness="1"
                                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                                Background="{Binding ThumbnailBrush}"
                                                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,8,0">
                                                        <TextBlock Text="{Binding FileName}" FontSize="12.5"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding MetaText}" Style="{StaticResource MetaTextStyle}" />
                                                            <TextBlock Text="  &#x00B7;  " Style="{StaticResource MetaTextStyle}"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                            <TextBlock Text="{Binding ErrorText}" FontSize="11"
                                                                       Foreground="{DynamicResource ErrorBrush}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="230"
                                                                       ToolTip="{Binding ErrorText}"
                                                                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource IconFont}"
                                                                   FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                                   Visibility="{Binding HasStatusGlyph, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                                                                   MaxWidth="190" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>

                                                    <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                                            Content="&#xE711;" Width="24" Height="24" FontSize="10"
                                                            Margin="4,0,0,0" Opacity="0.45"
                                                            Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove from queue" />
                                                    <ProgressBar Grid.ColumnSpan="4" VerticalAlignment="Bottom" Height="2"
                                                                 Style="{StaticResource ThinProgressBarStyle}"
                                                                 Value="{Binding Progress, Mode=OneWay}"
                                                                 Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- empty state -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,0,18">
                                        <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="No images queued yet &#x2014; drop a few above" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                                        <Button Style="{StaticResource LinkButtonStyle}" Content="Browse files"
                                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                                Command="{Binding BrowseFilesCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- options card -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="16,10,16,12">

                                        <TextBlock Text="Convert to" Style="{StaticResource SectionLabelStyle}" />
                                        <ComboBox Margin="0,7,0,0" Style="{StaticResource FluentComboBoxStyle}"
                                                  ItemsSource="{Binding Formats}"
                                                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                                  TextSearch.TextPath="Name">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Margin="0,5,0,0" Style="{StaticResource HintTextStyle}"
                                                   Text="{Binding FormatHint}" />

                                        <!-- quality -->
                                        <StackPanel Visibility="{Binding ShowQuality, Converter={StaticResource BoolToVis}}">
                                            <Grid Margin="0,10,0,0">
                                                <TextBlock Text="Quality" Style="{StaticResource SectionLabelStyle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding QualityText}" HorizontalAlignment="Right"
                                                           FontSize="11.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </Grid>
                                            <Slider Margin="0,4,-6,0" Minimum="1" Maximum="100"
                                                    Style="{StaticResource FluentSliderStyle}"
                                                    Value="{Binding Quality, Mode=TwoWay}" />
                                        </StackPanel>

                                        <!-- fill transparency -->
                                        <StackPanel Visibility="{Binding ShowFill, Converter={StaticResource BoolToVis}}">
                                            <Button x:Name="FillSwatchButton" Margin="0,9,0,0" Cursor="Hand"
                                                    Click="OnFillSwatchClick"
                                                    FocusVisualStyle="{StaticResource FluentFocusVisual}"
                                                    ToolTip="Pick the colour that replaces transparency">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Fill transparency"
                                                                       Style="{StaticResource SectionLabelStyle}"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Width="56" Height="24" CornerRadius="3"
                                                                    Background="{Binding FillColorBrush}"
                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                    BorderThickness="1" />
                                                            <TextBlock Grid.Column="2" x:Name="Chevron"
                                                                       Text="&#xE70D;" FontFamily="{StaticResource IconFont}"
                                                                       FontSize="9" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel Visibility="{Binding IsFillPaletteOpen, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,10,0,2">
                                                <!-- Palette is spelled out (not an ItemsControl) so every tile keeps a
                                                     deterministic hit area across renderers. -->
                                                <WrapPanel>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#FFFFFF"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#FFFFFF">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#FFFFFF"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#0A0B08"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#0A0B08">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#0A0B08"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#F1EFE8"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#F1EFE8">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#F1EFE8"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#E3E5DA"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#E3E5DA">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#E3E5DA"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="{Binding AccentSwatchHex}"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="{Binding AccentSwatchHex}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource AccentBrush}"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#52DBEA"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#52DBEA">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#52DBEA"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#B893FF"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#B893FF">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#B893FF"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#FF74B8"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#FF74B8">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#FF74B8"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#FF6067"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#FF6067">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#FF6067"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#E9D5B3"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#E9D5B3">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#E9D5B3"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#2C2F27"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#2C2F27">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#2C2F27"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                            <Button Width="26" Height="26" Margin="0,0,6,6" Cursor="Hand"
                                                                    Focusable="False" Tag="#0078D4"
                                                                    Click="OnFillColorPick"
                                                                    ToolTip="#0078D4">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Grid Background="Transparent">
                                                                            <Border x:Name="Bd" CornerRadius="4" Background="#0078D4"
                                                                                    BorderBrush="{DynamicResource ControlBorderStrongBrush}"
                                                                                    BorderThickness="1" />
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                                                        Value="{DynamicResource AccentBrush}" />
                                                                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                            </Button>
                                                </WrapPanel>
                                                <TextBox x:Name="FillHexBox" Style="{StaticResource FluentTextBoxStyle}"
                                                         Text="{Binding FillColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         Margin="0,2,0,0" />
                                                <TextBlock Text="Any hex value, for example #FFFFFF"
                                                           Style="{StaticResource HintTextStyle}" Margin="0,5,0,0" />
                                            </StackPanel>

                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource HintTextStyle}">
                                                <Run Text="Transparent areas become " />
                                                <Run Text="{Binding FillColor, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>

                                        <Border Style="{StaticResource DividerStyle}" Margin="0,12,0,0" />

                                        <!-- save to -->
                                        <TextBlock Text="Save to" Style="{StaticResource SectionLabelStyle}" Margin="0,9,0,0" />
                                        <Border Margin="0,7,0,0" CornerRadius="6" Padding="3"
                                                Background="{DynamicResource ControlBgBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                            <UniformGrid Columns="2">
                                                <RadioButton GroupName="SaveTo" Style="{StaticResource SegmentRadioStyle}"
                                                             Content="Same folder"
                                                             IsChecked="{Binding SameFolder, Mode=TwoWay}" />
                                                <RadioButton GroupName="SaveTo" Style="{StaticResource SegmentRadioStyle}"
                                                             Content="Choose folder"
                                                             IsChecked="{Binding ChooseFolder, Mode=TwoWay}" />
                                            </UniformGrid>
                                        </Border>

                                        <Grid Margin="0,8,0,0"
                                              Visibility="{Binding ChooseFolder, Converter={StaticResource BoolToVis}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource FluentTextBoxStyle}"
                                                     IsReadOnly="True" IsTabStop="False"
                                                     Text="{Binding OutputFolderDisplay, Mode=OneWay}"
                                                     ToolTip="{Binding OutputFolder}"
                                                     MouseLeftButtonUp="OnFolderBoxClick" Cursor="Hand" />
                                            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                                                    Content="&#xE8B7;" FontSize="14" Margin="4,0,0,0"
                                                    Command="{Binding BrowseFolderCommand}" ToolTip="Browse for a folder" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0"
                                                       Style="{StaticResource HintTextStyle}"
                                                       Text="Converted images are written here" />
                                        </Grid>

                                        <TextBlock Margin="0,4,0,0" FontSize="11"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding FolderError}"
                                                   Visibility="{Binding HasFolderError, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- footer actions -->
                        <Grid Grid.Row="3" Margin="0,9,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"
                                           Margin="1,0,7,0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                                           ToolTip="{Binding StatusTooltip}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ProgressBar Width="110" Margin="12,0,0,0" VerticalAlignment="Center"
                                             Style="{StaticResource ThinProgressBarStyle}"
                                             Value="{Binding OverallProgress, Mode=OneWay}"
                                             Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="14,0"
                                        Command="{Binding OpenFolderCommand}"
                                        Visibility="{Binding HasJobs, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource AccentButtonStyle}" Margin="10,0,0,0" MinWidth="132"
                                        Command="{Binding ConvertCommand}"
                                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Convert" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" MinWidth="132"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ========================================= settings page -->
                    <ScrollViewer Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVis}}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="22,14,5,0">
                        <!-- The right padding keeps the cards where they were while the
                             scrollbar slides out towards the window edge. -->
                        <StackPanel Margin="0,0,15,22">
                            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                       Text="Theme, accent colour and your default conversion options." />

                            <!-- appearance -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0" Padding="18,16,18,18">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,3,0,0"
                                               Text="A calm, layered Fluent surface with one accent colour used throughout the app." />

                                    <TextBlock Text="Visual theme" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,0" />
                                    <UniformGrid Columns="3" Margin="0,8,0,0">
                                        <RadioButton GroupName="Theme" Style="{StaticResource ThemeCardRadioStyle}"
                                                     Margin="0,0,8,0"
                                                     Command="{Binding SetThemeCommand}" CommandParameter="System"
                                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=System}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentTextBrush}" />
                                                <TextBlock Text="System" FontWeight="SemiBold" FontSize="12.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Theme" Style="{StaticResource ThemeCardRadioStyle}"
                                                     Margin="0,0,8,0"
                                                     Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Dark}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentTextBrush}" />
                                                <TextBlock Text="Dark" FontWeight="SemiBold" FontSize="12.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Theme" Style="{StaticResource ThemeCardRadioStyle}"
                                                     Margin="0,0,8,0"
                                                     Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                                     IsChecked="{Binding Theme, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Light}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="17"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                                           Foreground="{DynamicResource AccentTextBrush}" />
                                                <TextBlock Text="Light" FontWeight="SemiBold" FontSize="12.5"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,0" />

                                    <Grid Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Accent colour" Style="{StaticResource SectionLabelStyle}" />
                                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,2,0,0"
                                                       Text="System follows your Windows accent live. Black and white swap automatically with the theme." />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="{DynamicResource ControlBgBrush}" CornerRadius="10" Padding="10,2"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding AccentDisplayName}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AccentSwatches}" Margin="0,14,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="Accent" Style="{StaticResource AccentSwatchStyle}"
                                                             Margin="0,0,8,0"
                                                             Background="{Binding Fill}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             ToolTip="{Binding Tooltip}"
                                                             AutomationProperties.Name="{Binding Name}"
                                                             Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             CommandParameter="{Binding Id}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- defaults -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,16,18,18">
                                <StackPanel>
                                    <TextBlock Text="Conversion defaults" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,3,0,0"
                                               Text="Remembered between sessions. The converter page always reflects these choices." />

                                    <Grid Margin="0,16,0,0">
                                        <TextBlock Text="Output format" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ComboBox Width="150" HorizontalAlignment="Right"
                                                  Style="{StaticResource FluentComboBoxStyle}"
                                                  ItemsSource="{Binding Formats}"
                                                  SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                                  TextSearch.TextPath="Name">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <Grid Margin="0,14,0,0" Visibility="{Binding ShowQuality, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Quality" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Slider Width="180" Style="{StaticResource FluentSliderStyle}"
                                                    Minimum="1" Maximum="100" Value="{Binding Quality, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding QualityText}" Width="42" TextAlignment="Right"
                                                       FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,14,0,0" />

                                    <Grid Margin="0,12,0,0">
                                        <TextBlock Text="Overwrite existing files" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ToggleButton Style="{StaticResource FluentSwitchStyle}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding Overwrite, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Keep EXIF metadata" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ToggleButton Style="{StaticResource FluentSwitchStyle}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding KeepExif, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="Open folder when done" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <ToggleButton Style="{StaticResource FluentSwitchStyle}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding OpenAfterConvert, Mode=TwoWay}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- about -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="18,16,18,18">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="About" Style="{StaticResource CardTitleStyle}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Reset settings"
                                                HorizontalAlignment="Right" Click="OnResetSettingsClick" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <!-- the icon is the update entry point -->
                                        <Button Style="{StaticResource AboutIconButtonStyle}"
                                                Click="OnOpenProjectPage"
                                                ToolTip="Check for updates on GitHub">
                                            <Image Source="Assets/app-256.png" Width="46" Height="46"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Button>

                                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AppVersion}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock FontSize="11.5" Margin="0,3,0,0" LineHeight="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="Made by Mr KNIGHT," />
                                                <LineBreak />
                                                <Run Text="Made possible with AI," />
                                                <LineBreak />
                                                <Run Text="October 2026" />
                                            </TextBlock>
                                            <TextBlock Text="Free software &#x00B7; GNU GPL v3" FontSize="11"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="2,14,0,0"
                                       Text="Shortcuts:  Ctrl+O add images  &#x00B7;  Ctrl+Enter convert  &#x00B7;  Esc cancel  &#x00B7;  Delete remove selected  &#x00B7;  Ctrl+, settings" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- drag overlay -->
                    <Border x:Name="DragOverlay" Background="{DynamicResource DropHoverBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1.5" CornerRadius="8"
                            Margin="8" IsHitTestVisible="False" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                       Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Drop to add images" FontSize="13.5" FontWeight="SemiBold" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- transient notice -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                            Background="{DynamicResource PopupBgBrush}" BorderBrush="{DynamicResource PopupBorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="14,9"
                            Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.3" Color="Black" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,9,0"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="{Binding Notice}" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
