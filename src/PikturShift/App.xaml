<Application x:Class="PikturShift.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:PikturShift.Common"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <common:BoolToVisibilityConverter x:Key="BoolToVis" />
            <common:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True" />
            <common:EqualsConverter x:Key="Equals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
